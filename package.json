{
  "name": "e88-finsys",
  "version": "15.0.0",
  "private": true,
  "type": "module",
  "description": "Blitz - ERP for E88 Ventures Inc. Connected enterprise ERP on Cloudflare Workers + D1, with Google Drive document storage and email-driven approval chains.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run predeploy && wrangler deploy",
    "check": "node scripts/check-structure.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "test:integration": "node test/auth.integration.mjs",
    "test:data": "python scripts/self_test.py",
    "test:mobile": "node test/mobile-render.mjs",
    "test:viz": "node test/viz-render.mjs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:data",
    "build": "npm run check && npm test",
    "generate:data": "python scripts/generate_opening_data.py",
    "db:bootstrap:local": "node scripts/apply-database.mjs --local",
    "db:bootstrap:remote": "node scripts/apply-database.mjs --remote --confirm=E88_NEW_DATABASE",
    "smoke": "node scripts/smoke-test.mjs",
    "predeploy": "node scripts/predeploy-guard.mjs",
    "test:e2e": "node test/blitz-e2e.mjs",
    "test:goldenpath": "node test/goldenpath.mjs",
    "test:receivables": "node test/receivables-render.mjs",
    "test:centres": "node test/module-centres-render.mjs",
    "audit:ui": "node test/ui-audit.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "miniflare": "^4.20260722.1",
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=20"
  }
}
